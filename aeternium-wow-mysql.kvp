Meta.DisplayName=MySQL
Meta.Description=Original SPP bundled MySQL managed by AMP. Uses the complete native SPP Database folder unchanged.
Meta.OS=Windows
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=Aeternium
Meta.URL=https://github.com/KontoAuszug0205/amp
Meta.DisplayImageSource=url:https://www.bleepstatic.com/content/hl-images/2016/11/07/MySQL.jpg
Meta.EndpointURIFormat=
Meta.ConfigManifest=aeternium-wow-mysqlconfig.json
Meta.MetaConfigManifest=
Meta.ConfigRoot=aeternium-wow-mysql.kvp
Meta.MinAMPVersion=2.6.0.4
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=PreRelease
Meta.NoCommercialUsage=False
Meta.ConfigVersion=9
Meta.ReleaseNotes=Native SPP mode: AMP no longer downloads, initializes or rewrites MySQL. It starts the complete original SPP Database folder with the original Database.bat parameters.
Meta.BreakingReleaseNotes=Before starting, copy the complete WORKING SPP Database folder including bin, data, SPP-Database.ini and connection.cnf into the application directory as Database.
Meta.AppConfigId=b730a3e4-4cd2-4f9d-bfea-1a1fff9bf8c1
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False

App.DisplayName=MySQL
App.RootDir=./aeternium-wow-mysql/
