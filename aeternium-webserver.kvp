Meta.DisplayName=Aeternium Apache + PHP + phpMyAdmin
Meta.Description=Windows Apache web server with PHP and phpMyAdmin managed by AMP Generic Module
Meta.OS=Windows
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=Aeternium
Meta.URL=https://httpd.apache.org/
Meta.DisplayImageSource=url:https://httpd.apache.org/images/httpd_logo_wide_new.png
Meta.EndpointURIFormat=http://{ip}:{GenericModule.App.Ports.$HTTPPort}
Meta.ConfigManifest=aeternium-webserverconfig.json
Meta.MetaConfigManifest=aeternium-webservermetaconfig.json
Meta.ConfigRoot=aeternium-webserver.kvp
Meta.MinAMPVersion=2.6.0.4
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=PreRelease
Meta.NoCommercialUsage=False
Meta.ConfigVersion=3
Meta.ReleaseNotes=Dynamic AMP HTTP port binding, automatic Windows Firewall integration, PHP/phpMyAdmin fixes
Meta.BreakingReleaseNotes=
Meta.AppConfigId=31ff864c-80de-452d-8449-b692e8e24802
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False

App.DisplayName=Aeternium Apache + PHP + phpMyAdmin
App.RootDir=./aeternium-webserver/
App.BaseDirectory=./aeternium-webserver/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=Apache24\bin\httpd.exe
App.ExecutableLinux=
App.WorkingDir=Apache24
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=-C "Define HTTPPORT {{$HTTPPort}}" -f conf/httpd.conf
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={}
App.CommandLineParameterFormat=
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitMethodWindows=CtrlC
App.ExitTimeout=20
App.ExitString=
App.ExitFile=app_exit.lck
App.RestartDelaySeconds=2
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ForceIPBinding=False
App.SupportsIPv6=True
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[aeternium-webserverports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=HTTPPort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=-1
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.RCONSelectIPMethod=Default
App.TelnetLoginFormat={0}
App.TelnetNewLineType=Default
App.UpdateSources=@IncludeJson[aeternium-webserverupdates.json]
App.Compatibility=None
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.MonitorChildProcessName=
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=Immediate
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=^$
Console.UserJoinRegex=
Console.UserLeaveRegex=
Console.UserChatRegex=
Console.UpdateAvailableRegex=
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
