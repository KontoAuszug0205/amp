App.AdminMethod=STDIO
App.ApplicationReadyMode=Immediate
App.BaseDirectory=./world-of-warcraft-legion-/
App.CommandLineArgs=worldserver.exe
App.CommandLineParameterDelimiter= 
App.CommandLineParameterFormat=-{0} "{1}"
App.DisplayName=World of Warcraft Legion 
App.ExecutableLinux=/usr/bin/wine
App.ExecutableWin=worldserver.exe
App.ExitMethod=SIGINT
App.ExitString=stop
App.HasReadableConsole=true
App.HasWritableConsole=true
App.RapidStartup=false
App.RootDir=./world-of-warcraft-legion-/
App.UpdateSource=None
App.WorkingDir=
Console.AppReadyRegex=^Server is ready.$
Console.ThrowawayMessageRegex=^(WARNING|ERROR): Shader.+$
Console.UserChatRegex=^(?<username>.+?): (?<message>.+)$
Console.UserJoinRegex=^User (?<username>.+?) \((?<userid>-?d+)\) connected from \[::ffff:(?<endpoint>.+?)\]$
Console.UserLeaveRegex=^User (?<username>.+?) \((?<userid>-?d+)\) disconnected\. Reason: (.+?)$
Meta.Author=
Meta.ConfigManifest=world-of-warcraft-legion-config.json
Meta.ConfigRoot=world-of-warcraft-legion-.kvp
Meta.Description=LegionCore WoW Server
Meta.DisplayImageSource=url:https://imgur.com/jea2wLq
Meta.DisplayName=World of Warcraft Legion 
Meta.EndpointURIFormat=
Meta.OS=3
Meta.URL=