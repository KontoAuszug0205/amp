Meta.DisplayName=WoW - Auth + World
Meta.Description=Combined SPP Battle.net/Auth and World server. Starts Auth first, waits until it is ready, then starts World from the same Server folder.
Meta.OS=Windows
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=Aeternium
Meta.URL=https://github.com/KontoAuszug0205/amp
Meta.DisplayImageSource=url:https://images.cgames.de/images/gamestar/290/world-of-warcraft-legion_2717499.jpg
Meta.EndpointURIFormat=
Meta.ConfigManifest=
Meta.MetaConfigManifest=
Meta.ConfigRoot=aeternium-wow.kvp
Meta.MinAMPVersion=2.6.0.4
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=PreRelease
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=Combined native SPP layout. Keeps bnetserver.exe and worldserver.exe in one folder, starts Auth first, waits for ports 1119 and 8081, then starts World with AMP STDIO.
Meta.BreakingReleaseNotes=Copy the COMPLETE working SPP Servers folder contents into the Server directory. Data must remain in the sibling Data directory.
Meta.AppConfigId=767d3e60-a2fe-4dbc-9abe-50dabca2f1b7
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False

